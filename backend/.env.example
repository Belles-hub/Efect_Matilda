# Copie este arquivo para ".env" (na pasta backend/) e preencha.
# O ".env" real está no .gitignore e nunca deve ser commitado.

# Chave que assina os tokens de login por e-mail e senha.
# Gere uma aleatória, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio

# Chat com a Matilda (Groq). Sem a chave, o chat responde 503 e o resto da API funciona.
# Crie em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=

# Firebase: em desenvolvimento a chave de serviço é lida de
# backend/credentials/firebase-service-account.json (arquivo ignorado pelo git).
# Em produção, cole o JSON inteiro nesta variável:
# FIREBASE_CREDENTIALS_JSON=

# Opcionais
# CORS_ORIGINS_EXTRA=https://seu-frontend.onrender.com
# CONFIA_EM_PROXY_REVERSO=true
# SENTRY_DSN=
